# Server-side Supabase PostgreSQL connection for the optional reporting sync.
#
# 1. Rotate every password/key previously shared in chat.
# 2. Copy this file to .env.supabase.local.
# 3. Paste the fresh Session Pooler connection string from Supabase Connect.
# 4. Keep sslmode=require and never commit the local file.
#
# This is intentionally not a VITE_ or NEXT_PUBLIC_ variable. It must never be
# included in a browser bundle.

SISU_SUPABASE_SYNC_ENABLED="0"
SISU_SUPABASE_DATABASE_URL="postgresql://sisu_reporting_writer.PROJECT_REF:NEW_WRITER_PASSWORD@EXACT_SESSION_POOLER_HOST:5432/postgres?sslmode=require"
SISU_SUPABASE_SOURCE_SITE_ID="sisu-academy"
