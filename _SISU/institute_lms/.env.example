# Single project environment source. Copy this file to .env.
# VITE_ variables are public browser configuration; never put secrets in them.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

# Optional: used only by database verification/migration tooling.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:ROTATED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_SECRET_KEY=

FRONTEND_URL=http://127.0.0.1:5178
CORS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
ENVIRONMENT=development
