{
  "doctype": "DocType",
  "name": "IL Account Request",
  "module": "Institute LMS",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "institute",
    "requested_by",
    "kind",
    "reason",
    "status",
    "resolution"
  ],
  "fields": [
    {
      "fieldname": "institute",
      "label": "Institute",
      "fieldtype": "Link",
      "options": "IL Institute",
      "reqd": 1
    },
    {
      "fieldname": "requested_by",
      "label": "Requested by",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "kind",
      "label": "Request type",
      "fieldtype": "Select",
      "options": "delete_profile\ndelete_institute",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nIn Review\nCompleted\nCancelled",
      "default": "Pending"
    },
    {
      "fieldname": "resolution",
      "label": "Resolution notes",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "track_changes": true
}