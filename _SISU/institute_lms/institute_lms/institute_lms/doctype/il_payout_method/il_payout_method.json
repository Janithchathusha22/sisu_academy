      "options": "IL Wallet"
    },
    {
      "fieldname": "kind",
      "label": "Kind",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Local Bank\nWise\nPayoneer\nSWIFT / IBAN"
    },
    {
      "fieldname": "country",
      "label": "Country",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "masked_label",
      "label": "Masked Label",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "secret_details",
      "label": "Secret Details",
      "fieldtype": "Password",
      "length": 2048,
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "default": "Pending",
      "options": "Pending\nApproved\nRejected\nSuperseded"
    },
    {
      "fieldname": "submitted_by",
      "label": "Submitted By",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "reviewed_by",
      "label": "Reviewed By",
      "fieldtype": "Link",
      "options": "User"
