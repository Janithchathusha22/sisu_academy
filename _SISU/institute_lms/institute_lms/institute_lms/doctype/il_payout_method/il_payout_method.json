{
  "doctype": "DocType",
  "name": "IL Payout Method",
  "module": "Institute LMS",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "wallet",
    "kind",
    "country",
    "masked_label",
    "secret_details",
    "status",
    "submitted_by",
    "reviewed_by",
    "reviewed_at",
    "review_reason"
  ],
  "fields": [
    {
      "fieldname": "wallet",
      "label": "Wallet",
