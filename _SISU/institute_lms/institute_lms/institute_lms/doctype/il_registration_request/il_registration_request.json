{
  "doctype": "DocType",
  "name": "IL Registration Request",
  "module": "Institute LMS",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "email",
    "account_type",
    "status",
    "email_verified",
    "details",
    "review_reason",
    "reviewed_by"
  ],
  "fields": [
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "options": "Email",
      "reqd": 1
    },
    {
      "fieldname": "account_type",
      "label": "Account Type",
      "fieldtype": "Select",
      "options": "Institute\nIndividual Teacher\nStudent\nSuper Admin",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending review\nApproved\nRejected",
      "default": "Pending review",
      "reqd": 1
    },
    {
      "fieldname": "email_verified",
      "label": "Email Verified",
      "fieldtype": "Check",
      "read_only": 1
    },
    {
      "fieldname": "details",
      "label": "Registration Details",
      "fieldtype": "Long Text",
      "read_only": 1
    },
    {
      "fieldname": "review_reason",
      "label": "Review reason",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "reviewed_by",
      "label": "Reviewed by",
      "fieldtype": "Link",
      "options": "User"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0,
      "email": 0,
      "export": 0,
      "print": 0,
      "share": 0
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "engine": "InnoDB"
}
